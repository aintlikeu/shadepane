<protection:ProtectedWindow x:Class="Shadepane.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:protection="clr-namespace:Shadepane.App.Protection"
        Title="Shadepane" Width="1280" Height="800"
        Background="{DynamicResource Brush.Frame}">
    <DockPanel>
        <!-- Строка вкладок -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,0" LastChildFill="True">
            <Button x:Name="NewTabButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="30" Height="30" Margin="4,0,0,2"
                    VerticalAlignment="Bottom" IsEnabled="False" Click="NewTab_Click" ToolTip="Новая вкладка (Ctrl+T)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Add}"/></Button>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Панель навигации -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}" LastChildFill="True">
            <DockPanel Margin="8,6" LastChildFill="True">
                <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="Back_Click" ToolTip="Назад (Alt+←)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Back}"/></Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" IsEnabled="False" Click="Forward_Click" ToolTip="Вперёд (Alt+→)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Forward}"/></Button>
                <Button x:Name="ReloadButton" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" IsEnabled="False" Click="Reload_Click" ToolTip="Обновить (F5)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Reload}"/></Button>
                <Button x:Name="HomeButton" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" IsEnabled="False" Click="Home_Click" ToolTip="Домашняя страница (Alt+Home)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Home}"/></Button>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" IsEnabled="False"
                        Click="Settings_Click" ToolTip="Настройки"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Settings}"/></Button>
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarTextButton}" Height="34" Margin="2,0,0,0" Visibility="Collapsed"
                        Foreground="{DynamicResource Brush.AccentText}" FontWeight="SemiBold" Click="Update_Click"/>
                <Button x:Name="HistoryButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"
                        Click="History_Click" ToolTip="История (Ctrl+H)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.History}"/></Button>
                <Button x:Name="DownloadsButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"
                        Click="Downloads_Click" ToolTip="Загрузки (Ctrl+J)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Downloads}"/></Button>
                <Button x:Name="AddExtensionButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"
                        IsEnabled="False" Click="AddExtension_Click" ToolTip="Добавить распакованное расширение (папку с manifest.json)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Extension}"/></Button>
                <StackPanel x:Name="ExtensionBar" DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0"/>
                <!-- Адресная строка. Без фокуса поверх поля показан адрес с выделенным доменом (AddressDisplay),
                     в фокусе — обычное поле ввода с полным адресом. -->
                <Border x:Name="AddressPill" Height="34" Margin="8,0,6,0" CornerRadius="17" BorderThickness="1" Padding="4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Pill}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AddressBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BookmarkButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="28" Height="28" IsEnabled="False"
                                Click="Bookmark_Click" ToolTip="Добавить в закладки (Ctrl+D)"><Path x:Name="BookmarkGlyph" Style="{StaticResource Glyph}" Data="{StaticResource Icon.Star}"/></Button>
                        <Grid>
                            <TextBox x:Name="AddressBox" Margin="6,0,4,0" VerticalContentAlignment="Center" IsEnabled="False"
                                     BorderThickness="0" Background="Transparent" FontSize="14"
                                     Foreground="{DynamicResource Brush.Ink}" CaretBrush="{DynamicResource Brush.Ink}"
                                     SelectionBrush="{DynamicResource Brush.Accent}"
                                     KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                     LostKeyboardFocus="AddressBox_LostKeyboardFocus"/>
                            <TextBlock x:Name="AddressView" Margin="9,0,4,0" VerticalAlignment="Center" FontSize="14"
                                       TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>

        <!-- Панель закладок (Ctrl+Shift+B). Кнопки, не поместившиеся по ширине, доступны через «»». -->
        <Border x:Name="BookmarksBar" DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0,10,4" LastChildFill="True">
                <Button x:Name="BookmarksOverflowButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="28" Height="26" Margin="4,0,0,0"
                        Click="BookmarksOverflow_Click" ToolTip="Все закладки"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.More}"/></Button>
                <Grid ClipToBounds="True">
                    <StackPanel x:Name="BookmarksBarItems" Orientation="Horizontal"/>
                    <TextBlock x:Name="BookmarksBarEmpty" Text="Закладок пока нет — нажмите ☆ или Ctrl+D на нужной странице"
                               Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Поиск на странице (Ctrl+F). Встроенная панель WebView2 скрыта, ищем через CoreWebView2.Find. -->
        <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,4" LastChildFill="False">
                <TextBlock Text="Найти на странице:" VerticalAlignment="Center"/>
                <TextBox x:Name="FindBox" Width="280" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
                <TextBlock x:Name="FindCount" Margin="10,0,0,0" MinWidth="60" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"/>
                <Button Style="{StaticResource ToolbarButton}" Width="30" Height="30" Margin="4,0,0,0" Click="FindPrevious_Click" ToolTip="Предыдущее (Shift+F3, Shift+Enter)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Up}"/></Button>
                <Button Style="{StaticResource ToolbarButton}" Width="30" Height="30" Margin="2,0,0,0" Click="FindNext_Click" ToolTip="Следующее (F3, Enter)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Down}"/></Button>
                <Button Style="{StaticResource ToolbarButton}" Width="30" Height="30" Margin="2,0,0,0" Click="FindClose_Click" ToolTip="Закрыть (Esc)"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Close}"/></Button>
            </DockPanel>
        </Border>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,2" Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis"/>

        <Grid Background="{DynamicResource Brush.Control}">
            <!-- Сюда добавляются WebView2 вкладок; видна только активная. -->
            <Grid x:Name="ContentHost"/>
            <!-- WPF не может рисовать поверх HWND WebView2 (airspace), поэтому при нарушении защиты скрываем ContentHost целиком. -->
            <TextBlock x:Name="HiddenNotice" Visibility="Collapsed" Text="Контент скрыт политикой защиты"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
        </Grid>
    </DockPanel>
</protection:ProtectedWindow>
