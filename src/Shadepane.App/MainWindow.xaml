<protection:ProtectedWindow x:Class="Shadepane.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:protection="clr-namespace:Shadepane.App.Protection"
        Title="Shadepane" Width="1280" Height="800">
    <DockPanel>
        <!-- Строка вкладок -->
        <DockPanel DockPanel.Dock="Top" Margin="4,4,4,0" LastChildFill="True">
            <Button x:Name="NewTabButton" DockPanel.Dock="Right" Content="+" Width="28" Margin="4,0,0,0"
                    IsEnabled="False" Click="NewTab_Click" ToolTip="Новая вкладка (Ctrl+T)"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Панель навигации -->
        <DockPanel DockPanel.Dock="Top" Margin="6" LastChildFill="True">
            <Button x:Name="BackButton" Content="←" Width="32" IsEnabled="False" Click="Back_Click" ToolTip="Назад (Alt+←)"/>
            <Button x:Name="ForwardButton" Content="→" Width="32" Margin="4,0,0,0" IsEnabled="False" Click="Forward_Click" ToolTip="Вперёд (Alt+→)"/>
            <Button x:Name="ReloadButton" Content="⟳" Width="32" Margin="4,0,0,0" IsEnabled="False" Click="Reload_Click" ToolTip="Обновить (F5)"/>
            <Button x:Name="HomeButton" Content="⌂" Width="32" Margin="4,0,0,0" IsEnabled="False" Click="Home_Click" ToolTip="Домашняя страница (Alt+Home)"/>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="⚙" Width="32" Margin="6,0,0,0" IsEnabled="False"
                    Click="Settings_Click" ToolTip="Настройки"/>
            <Button x:Name="AddExtensionButton" DockPanel.Dock="Right" Content="+ Расширение…" Margin="6,0,0,0" Padding="8,2"
                    IsEnabled="False" Click="AddExtension_Click" ToolTip="Добавить распакованное расширение (папку с manifest.json)"/>
            <StackPanel x:Name="ExtensionBar" DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0"/>
            <TextBox x:Name="AddressBox" Margin="6,0,0,0" VerticalContentAlignment="Center" IsEnabled="False"
                     KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus"/>
        </DockPanel>

        <!-- Поиск на странице (Ctrl+F). Встроенная панель WebView2 скрыта, ищем через CoreWebView2.Find. -->
        <DockPanel x:Name="FindBar" DockPanel.Dock="Top" Margin="6,0,6,4" Visibility="Collapsed" LastChildFill="False">
            <TextBlock Text="Найти на странице:" VerticalAlignment="Center"/>
            <TextBox x:Name="FindBox" Width="280" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
            <TextBlock x:Name="FindCount" Margin="8,0,0,0" MinWidth="60" VerticalAlignment="Center" Foreground="Gray"/>
            <Button Content="↑" Width="28" Margin="4,0,0,0" Click="FindPrevious_Click" ToolTip="Предыдущее (Shift+F3, Shift+Enter)"/>
            <Button Content="↓" Width="28" Margin="4,0,0,0" Click="FindNext_Click" ToolTip="Следующее (F3, Enter)"/>
            <Button Content="✕" Width="28" Margin="4,0,0,0" Click="FindClose_Click" ToolTip="Закрыть (Esc)"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,2" Foreground="Gray" TextTrimming="CharacterEllipsis"/>

        <Grid>
            <!-- Сюда добавляются WebView2 вкладок; видна только активная. -->
            <Grid x:Name="ContentHost"/>
            <!-- WPF не может рисовать поверх HWND WebView2 (airspace), поэтому при нарушении защиты скрываем ContentHost целиком. -->
            <TextBlock x:Name="HiddenNotice" Visibility="Collapsed" Text="Контент скрыт политикой защиты"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
        </Grid>
    </DockPanel>
</protection:ProtectedWindow>
