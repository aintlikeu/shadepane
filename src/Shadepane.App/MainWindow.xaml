<protection:ProtectedWindow x:Class="Shadepane.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:protection="clr-namespace:Shadepane.App.Protection"
        xmlns:l="clr-namespace:Shadepane.App.Localization"
        Title="Shadepane" Width="1280" Height="800" MinWidth="560" MinHeight="360"
        Background="{DynamicResource Brush.Frame}">
    <!-- Вкладки в заголовке окна, как в Edge и Chrome. Верхние 40 px — область заголовка: за неё окно перетаскивают,
         двойной щелчок разворачивает. Вкладки и кнопки помечены IsHitTestVisibleInChrome — они получают клики сами.
         Системные кнопки заменены своими; «Развернуть» отвечает системе как HTMAXBUTTON, чтобы на Windows 11 при наведении
         показывались раскладки Snap (MainWindow.TitleBar.cs). -->
    <WindowChrome.WindowChrome>
        <!-- Слева, справа и снизу рамка остаётся системной (NonClientFrameEdges): её невидимая полоса для изменения
             размера лежит снаружи окна и работает и над страницей. Внутри окна её не сделать — там окно WebView2,
             и движения мыши над ним до заголовка не доходят. Своя только верхняя часть: ResizeBorderThickness — верхний край.
             GlassFrameThickness не 0: при 0 WindowChrome считает, что стекла нет, и ставит окну регион (SetWindowRgn) —
             невидимая системная рамка становится видимой светлой полосой, пропадают тень и скругление Windows 11.
             1 px снизу этого не делает, а под содержимым окна он не виден. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      NonClientFrameEdges="Left,Right,Bottom" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <DockPanel x:Name="RootPanel">
        <!-- Строка вкладок = заголовок окна -->
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="TabsColumn" Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Grid.Column="0" Width="16" Height="16" Margin="14,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <ScrollViewer x:Name="TabScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Bottom" PreviewMouseWheel="TabScroller_PreviewMouseWheel">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
            </ScrollViewer>
            <Button x:Name="NewTabButton" Grid.Column="2" Style="{StaticResource ToolbarButton}" Width="30" Height="30" Margin="4,0,0,2"
                    VerticalAlignment="Bottom" IsEnabled="False" Click="NewTab_Click" ToolTip="{l:Tr Ru='Новая вкладка (Ctrl+T)', En='New tab (Ctrl+T)'}"
                    WindowChrome.IsHitTestVisibleInChrome="True"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Add}"/></Button>
            <!-- Колонка 3 — пустое место заголовка: за него окно перетаскивают. Ширину вкладок держим так, чтобы оно оставалось. -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="{l:Tr Ru='Свернуть', En='Minimize'}"
                        AutomationProperties.Name="{l:Tr Ru='Свернуть', En='Minimize'}"><Path Style="{StaticResource SmallGlyph}" Data="{StaticResource Icon.Minimize}"/></Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="{l:Tr Ru='Развернуть', En='Maximize'}"
                        AutomationProperties.Name="{l:Tr Ru='Развернуть', En='Maximize'}"><Path x:Name="MaximizeGlyph" Style="{StaticResource SmallGlyph}" Data="{StaticResource Icon.Maximize}"/></Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Click="CloseWindow_Click" ToolTip="{l:Tr Ru='Закрыть', En='Close'}"
                        AutomationProperties.Name="{l:Tr Ru='Закрыть', En='Close'}"><Path Style="{StaticResource SmallGlyph}" Data="{StaticResource Icon.Close}"/></Button>
            </StackPanel>
        </Grid>

        <!-- Панель навигации -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}" LastChildFill="True">
            <DockPanel Margin="8,6" LastChildFill="True">
                <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="Back_Click" ToolTip="{l:Tr Ru='Назад (Alt+←)', En='Back (Alt+←)'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Back}"/></Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" IsEnabled="False" Click="Forward_Click" ToolTip="{l:Tr Ru='Вперёд (Alt+→)', En='Forward (Alt+→)'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Forward}"/></Button>
                <Button x:Name="ReloadButton" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" IsEnabled="False" Click="Reload_Click" ToolTip="{l:Tr Ru='Обновить (F5)', En='Reload (F5)'}"><Path x:Name="ReloadGlyph" Style="{StaticResource Glyph}" Data="{StaticResource Icon.Reload}"/></Button>
                <!-- Меню браузера: история, закладки, масштаб, поиск, настройки и т. д. (BuildMainMenu). -->
                <Button x:Name="MenuButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" IsEnabled="False"
                        Click="Menu_Click" ToolTip="{l:Tr Ru='Меню', En='Menu'}" AutomationProperties.Name="{l:Tr Ru='Меню', En='Menu'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Menu}"/></Button>
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarTextButton}" Height="34" Margin="2,0,0,0" Visibility="Collapsed"
                        Foreground="{DynamicResource Brush.AccentText}" FontWeight="SemiBold" Click="Update_Click"/>
                <Button x:Name="DownloadsButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"
                        Click="Downloads_Click" ToolTip="{l:Tr Ru='Загрузки (Ctrl+J)', En='Downloads (Ctrl+J)'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Downloads}"/></Button>
                <Button x:Name="ExtensionsButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"
                        IsEnabled="False" Click="Extensions_Click" ToolTip="{l:Tr Ru='Расширения', En='Extensions'}" AutomationProperties.Name="{l:Tr Ru='Расширения', En='Extensions'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Extension}"/></Button>
                <StackPanel x:Name="ExtensionBar" DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0"/>
                <!-- Адресная строка. Без фокуса поверх поля показан адрес с выделенным доменом (AddressDisplay),
                     в фокусе — обычное поле ввода с полным адресом. -->
                <Border x:Name="AddressPill" Height="34" Margin="8,0,6,0" CornerRadius="17" BorderThickness="1" Padding="4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Pill}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AddressBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Control}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BookmarkButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="28" Height="28" IsEnabled="False"
                                Click="Bookmark_Click" ToolTip="{l:Tr Ru='Добавить в закладки (Ctrl+D)', En='Add to bookmarks (Ctrl+D)'}"><Path x:Name="BookmarkGlyph" Style="{StaticResource Glyph}" Data="{StaticResource Icon.Star}"/></Button>
                        <!-- Индикатор защиты: состояние выбирает ProtectionStatus, по нажатию — сведения о защите. -->
                        <Button x:Name="ProtectionChip" DockPanel.Dock="Left" Style="{StaticResource ProtectionChip}" Click="ProtectionChip_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="ProtectionGlyph" Style="{StaticResource Glyph}" Data="{StaticResource Icon.ShieldCheck}"/>
                                <TextBlock x:Name="ProtectionLabel" Margin="6,0,0,0" VerticalAlignment="Center" Text="{l:Tr Ru='Защищено', En='Protected'}"/>
                            </StackPanel>
                        </Button>
                        <Grid>
                            <!-- Без прозрачности (AllowsTransparency=False): обычное окно, на него надёжно ставится защита от захвата. -->
                            <Popup x:Name="ProtectionPopup" PlacementTarget="{Binding ElementName=ProtectionChip}" Placement="Bottom"
                                   VerticalOffset="6" StaysOpen="False" AllowsTransparency="False" Opened="ProtectionPopup_Opened">
                                <Border Width="360" Padding="16" Background="{DynamicResource Brush.Control}"
                                        BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1"
                                        TextElement.Foreground="{DynamicResource Brush.Ink}" TextElement.FontSize="13">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="ProtectionPopupGlyph" Style="{StaticResource Glyph}" Fill="{DynamicResource Brush.Accent}"
                                                  Data="{StaticResource Icon.ShieldCheck}"/>
                                            <TextBlock x:Name="ProtectionTitle" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ProtectionSummary" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}"/>
                                        <Grid x:Name="ProtectionDetails">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <TextBox x:Name="AddressBox" Margin="6,0,4,0" VerticalContentAlignment="Center" IsEnabled="False"
                                     BorderThickness="0" Background="Transparent" Padding="0" FontSize="14"
                                     Foreground="{DynamicResource Brush.Ink}" CaretBrush="{DynamicResource Brush.Ink}"
                                     SelectionBrush="{DynamicResource Brush.Accent}"
                                     KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                     LostKeyboardFocus="AddressBox_LostKeyboardFocus"/>
                            <TextBlock x:Name="AddressView" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="14"
                                       TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>

        <!-- Полоска загрузки страницы: бегущий отрезок, пока активная вкладка загружается. Высота постоянная,
             чтобы страница не прыгала. -->
        <Canvas x:Name="LoadingTrack" DockPanel.Dock="Top" Height="2" Background="{DynamicResource Brush.Surface}" ClipToBounds="True"
                SizeChanged="LoadingTrack_SizeChanged">
            <Rectangle x:Name="LoadingBar" Height="2" Width="160" Fill="{DynamicResource Brush.Accent}" RadiusX="1" RadiusY="1" Visibility="Hidden">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="LoadingBarShift"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <!-- Панель закладок (Ctrl+Shift+B). Кнопки, не поместившиеся по ширине, доступны через «»». -->
        <Border x:Name="BookmarksBar" DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0,10,4" LastChildFill="True">
                <Button x:Name="BookmarksOverflowButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="28" Height="26" Margin="4,0,0,0"
                        Click="BookmarksOverflow_Click" ToolTip="{l:Tr Ru='Все закладки', En='All bookmarks'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.More}"/></Button>
                <!-- Закладки можно переставлять перетаскиванием; черта показывает, куда встанет закладка. Background нужен,
                     чтобы перетаскивание «видело» и пустое место справа от закладок. -->
                <Grid ClipToBounds="True" AllowDrop="True" Background="Transparent"
                      DragEnter="BookmarksBar_DragOver" DragOver="BookmarksBar_DragOver" DragLeave="BookmarksBar_DragLeave" Drop="BookmarksBar_Drop">
                    <StackPanel x:Name="BookmarksBarItems" Orientation="Horizontal"/>
                    <Rectangle x:Name="BookmarkDropMarker" Width="2" Height="22" RadiusX="1" RadiusY="1" HorizontalAlignment="Left"
                               VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <TextBlock x:Name="BookmarksBarEmpty" Text="{l:Tr Ru='Закладок пока нет — нажмите ☆ или Ctrl+D на нужной странице', En='No bookmarks yet. Press ☆ or Ctrl+D on a page to add one'}"
                               Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Поиск на странице (Ctrl+F). Встроенная панель WebView2 скрыта, ищем через CoreWebView2.Find. -->
        <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,4" LastChildFill="False">
                <TextBlock Text="{l:Tr Ru='Найти на странице:', En='Find on page:'}" VerticalAlignment="Center"/>
                <TextBox x:Name="FindBox" Width="280" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
                <TextBlock x:Name="FindCount" Margin="10,0,0,0" MinWidth="60" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"/>
                <Button Style="{StaticResource ToolbarButton}" Width="30" Height="30" Margin="4,0,0,0" Click="FindPrevious_Click" ToolTip="{l:Tr Ru='Предыдущее (Shift+F3, Shift+Enter)', En='Previous (Shift+F3, Shift+Enter)'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Up}"/></Button>
                <Button Style="{StaticResource ToolbarButton}" Width="30" Height="30" Margin="2,0,0,0" Click="FindNext_Click" ToolTip="{l:Tr Ru='Следующее (F3, Enter)', En='Next (F3, Enter)'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Down}"/></Button>
                <Button Style="{StaticResource ToolbarButton}" Width="30" Height="30" Margin="2,0,0,0" Click="FindClose_Click" ToolTip="{l:Tr Ru='Закрыть (Esc)', En='Close (Esc)'}"><Path Style="{StaticResource Glyph}" Data="{StaticResource Icon.Close}"/></Button>
            </DockPanel>
        </Border>

        <!-- Уведомление под панелями (вместо строки состояния внизу): справка исчезает сама через несколько секунд,
             предупреждение — по «Закрыть», при переходе или смене вкладки. Это строка над страницей, а не всплывающее окно:
             поверх WebView2 WPF рисовать не может. -->
        <Border x:Name="NoticeBar" DockPanel.Dock="Top" Visibility="Collapsed" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,3,6,3" LastChildFill="True">
                <Path x:Name="NoticeIcon" Style="{StaticResource Glyph}" VerticalAlignment="Center" Data="{StaticResource Icon.Info}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarTextButton}" Height="28" FontWeight="SemiBold"
                        Content="{l:Tr Ru='Закрыть', En='Close'}" Click="NoticeClose_Click"/>
                <TextBlock x:Name="NoticeText" Margin="8,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>

        <Grid Background="{DynamicResource Brush.Control}">
            <!-- Сюда добавляются WebView2 вкладок; видна только активная. -->
            <Grid x:Name="ContentHost"/>
            <!-- WPF не может рисовать поверх HWND WebView2 (airspace), поэтому при нарушении защиты скрываем ContentHost целиком. -->
            <TextBlock x:Name="HiddenNotice" Visibility="Collapsed" Text="{l:Tr Ru='Контент скрыт политикой защиты', En='Content is hidden by the protection policy'}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
        </Grid>
    </DockPanel>
</protection:ProtectedWindow>
