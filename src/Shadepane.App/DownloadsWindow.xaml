<protection:ProtectedWindow x:Class="Shadepane.App.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:protection="clr-namespace:Shadepane.App.Protection"
        Title="Загрузки — Shadepane" Width="820" Height="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock x:Name="DisabledNote" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Открыть" Width="100" Click="Open_Click"/>
            <Button Content="Показать в папке" Width="130" Margin="8,0,0,0" Click="ShowInFolder_Click"/>
            <Button Content="Пауза / продолжить" Width="140" Margin="8,0,0,0" Click="Pause_Click"/>
            <Button Content="Отменить" Width="100" Margin="8,0,0,0" Click="Cancel_Click"/>
            <Button Content="Очистить завершённые" Width="160" Margin="8,0,0,0" Click="ClearFinished_Click"/>
        </StackPanel>
        <ListView x:Name="List" SelectionMode="Single" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Файл" Width="260" DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="Состояние" Width="230" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Адрес" Width="280" DisplayMemberBinding="{Binding Url}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</protection:ProtectedWindow>
