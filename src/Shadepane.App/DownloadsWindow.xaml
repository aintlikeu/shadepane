<protection:ProtectedWindow x:Class="Shadepane.App.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:protection="clr-namespace:Shadepane.App.Protection"
        xmlns:l="clr-namespace:Shadepane.App.Localization"
        Title="{l:Tr Ru='Загрузки — Shadepane', En='Downloads — Shadepane'}" Width="820" Height="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock x:Name="DisabledNote" DockPanel.Dock="Top" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{l:Tr Ru='Открыть', En='Open'}" Width="100" Click="Open_Click"/>
            <Button Content="{l:Tr Ru='Показать в папке', En='Show in folder'}" Width="130" Margin="8,0,0,0" Click="ShowInFolder_Click"/>
            <Button Content="{l:Tr Ru='Пауза / продолжить', En='Pause / resume'}" Width="140" Margin="8,0,0,0" Click="Pause_Click"/>
            <Button Content="{l:Tr Ru='Отменить', En='Cancel'}" Width="100" Margin="8,0,0,0" Click="Cancel_Click"/>
            <Button Content="{l:Tr Ru='Очистить завершённые', En='Clear finished'}" Width="160" Margin="8,0,0,0" Click="ClearFinished_Click"/>
        </StackPanel>
        <ListView x:Name="List" SelectionMode="Single" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{l:Tr Ru='Файл', En='File'}" Width="260" DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="{l:Tr Ru='Состояние', En='Status'}" Width="230" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="{l:Tr Ru='Адрес', En='Address'}" Width="280" DisplayMemberBinding="{Binding Url}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</protection:ProtectedWindow>
