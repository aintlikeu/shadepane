<protection:ProtectedWindow x:Class="Shadepane.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:protection="clr-namespace:Shadepane.App.Protection"
        Title="Настройки — Shadepane" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <GroupBox Header="Домашняя страница" Padding="8">
            <StackPanel>
                <RadioButton x:Name="HomeSearchEngine" Content="Страница поисковика" GroupName="Home" Checked="HomeKind_Changed"/>
                <RadioButton x:Name="HomeBlank" Content="Пустая страница" GroupName="Home" Margin="0,4,0,0" Checked="HomeKind_Changed"/>
                <DockPanel Margin="0,4,0,0">
                    <RadioButton x:Name="HomeCustom" Content="Адрес:" GroupName="Home" VerticalAlignment="Center" Checked="HomeKind_Changed"/>
                    <TextBox x:Name="HomeUrlBox" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="HomeLockedNote" Text="Задано администратором" Foreground="Gray" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Поиск из адресной строки" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <ComboBox x:Name="SearchEngineBox" SelectionChanged="SearchEngine_Changed"/>
                <TextBox x:Name="CustomSearchBox" Margin="0,6,0,0" VerticalContentAlignment="Center"
                         ToolTip="https-адрес, где {query} будет заменён поисковым запросом"/>
                <TextBlock x:Name="CustomSearchHint" Text="Пример: https://search.example/?q={query}" Foreground="Gray" Margin="0,2,0,0"/>
                <TextBlock x:Name="SearchLockedNote" Text="Задано администратором" Foreground="Gray" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Расширения" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="ClipboardBox" Content="Разрешить расширениям читать буфер обмена"/>
                <TextBlock Text="Изменение вступит в силу после перезапуска браузера." Foreground="Gray" Margin="0,2,0,0"/>
                <TextBlock x:Name="ClipboardLockedNote" Text="Задано администратором" Foreground="Gray" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Загрузки" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="AllowDownloadsBox" Content="Разрешить загрузку файлов"/>
                <TextBlock x:Name="DownloadsLockedNote" Text="Задано администратором" Foreground="Gray" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Закладки" Padding="8" Margin="0,10,0,0">
            <CheckBox x:Name="ShowBookmarksBarBox" Content="Показывать панель закладок (Ctrl+Shift+B)"/>
        </GroupBox>

        <GroupBox Header="История" Padding="8" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Очистить историю…" Padding="8,2" Click="ClearHistory_Click"/>
                <CheckBox x:Name="SaveHistoryBox" Content="Сохранять историю посещений" VerticalAlignment="Center"/>
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Обновления" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Проверить сейчас" Padding="8,2" Click="CheckUpdates_Click"/>
                    <CheckBox x:Name="CheckUpdatesBox" Content="Проверять обновления автоматически (GitHub Releases)" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="VersionText" Foreground="Gray" Margin="0,4,0,0"/>
                <TextBlock x:Name="UpdatesLockedNote" Text="Задано администратором" Foreground="Gray" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="Сохранить" Width="100" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" Width="100" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</protection:ProtectedWindow>
