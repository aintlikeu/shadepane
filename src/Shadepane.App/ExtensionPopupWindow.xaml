<protection:ProtectedWindow x:Class="Shadepane.App.ExtensionPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:protection="clr-namespace:Shadepane.App.Protection"
        xmlns:l="clr-namespace:Shadepane.App.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="400" Height="560" WindowStyle="ToolWindow" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid>
        <wv2:WebView2 x:Name="WebView"/>
        <TextBlock x:Name="HiddenNotice" Visibility="Collapsed" Text="{l:Tr Ru='Контент скрыт', En='Content hidden'}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</protection:ProtectedWindow>
