{
  // Пример корпоративной политики. Как установить её так, чтобы сотрудник не мог её изменить,
  // см. README.md, раздел «Политика».
  // Домашняя страница. Если задана — действует и БЛОКИРУЕТ настройку пользователя.
  // "homeUrl": "https://intranet.corp.example",
  "protectedHosts": ["*.corp.example", "crm.partner.example"],
  "blockedPermissions": [
    "tabCapture", "desktopCapture", "pageCapture", "debugger", "activeTab", "downloads",
    "tabs", "history", "webNavigation", "declarativeNetRequestFeedback", "topSites", "sessions", "proxy"
  ],
  // Чтение буфера обмена расширениями (право clipboardRead). Если задано — БЛОКИРУЕТ настройку пользователя.
  // "allowExtensionClipboardRead": false,
  // Режим белого списка (рекомендуется для продуктива): разрешены только перечисленные права.
  // "allowedPermissions": ["storage", "alarms", "contextMenus", "notifications", "i18n"],
  "allowBroadHostAccess": false,
  // Разрешить пользователю при установке выдать отдельному расширению доступ ко всем сайтам и права tabs, history,
  // webNavigation и т. п. (окно «Дать права»). В политике по умолчанию выключено; без политики — включено.
  "allowExtensionPermissionGrants": false,
  "allowManifestV2": false,
  // Загрузка файлов. Если задано — БЛОКИРУЕТ настройку пользователя.
  // "allowDownloads": false,
  // Восстановление вкладок прошлого сеанса (адреса вкладок хранятся в session.json). false — запрещено, ничего не хранится.
  // "restoreSession": false,
  "blockInRemoteSession": true
}
